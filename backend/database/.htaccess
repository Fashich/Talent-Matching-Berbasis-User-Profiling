# Blok akses langsung lewat URL browser — folder ini isinya skema
# database (schema.sql) yang cuma dipakai internal (import ke
# MySQL/TiDB Cloud), bukan buat diakses publik.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
